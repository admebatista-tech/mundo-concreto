# MUNDO CONCRETO em farol.pro/mundoconcreto (Hostinger). O site fica em public/, a API em php/.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# nada fora de public/ e php/ é servido
RewriteRule ^(\.git|dados|dados-inicial|data|ferramentas|node_modules)(/|$) - [F,L]
RewriteRule ^(server\.js|README\.md|\.gitignore|package\.json)$ - [F,L]
RewriteRule ^php/(comum)\.php$ - [F,L]

RewriteRule ^api/(.*)$ php/api.php?r=$1 [QSA,L]
RewriteRule ^admin/$ admin [R=301,L]
RewriteRule ^admin(\.html)?$ php/admin.php [L]
RewriteRule ^entrar/$ entrar [R=301,L]
RewriteRule ^entrar(\.html)?$ php/entrar.php [L]
RewriteRule ^diagnostico$ diagnostico/ [R=301,L]

RewriteCond %{REQUEST_URI} !/public/
RewriteCond %{REQUEST_URI} !/php/
RewriteRule ^(.*)$ public/$1 [L]
